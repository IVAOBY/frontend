{
  "name": "by-frontend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@mantine/core": "^6.0.21",
    "@mantine/form": "^6.0.18",
    "@mantine/hooks": "^6.0.21",
    "@mantine/notifications": "^6.0.18",
    "@tabler/icons-react": "^2.42.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.10",
    "@types/mapbox-gl": "^2.7.19",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@types/react-i18next": "^8.1.0",
    "@vitejs/plugin-react": "^4.2.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.4.1",
    "i18next": "^23.7.7",
    "i18next-browser-languagedetector": "^7.2.0",
    "jwt-decode": "^3.1.2",
    "mapbox-gl": "^2.15.0",
    "npm-check": "^6.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "react-map-gl": "^7.1.6",
    "react-router-dom": "^6.20.0",
    "react-spinners": "^0.13.8",
    "react-typed": "^1.2.0",
    "tailwind-merge": "^2.2.0",
    "typescript": "^5.3.2",
    "vite": "5.1.6",
    "vite-tsconfig-paths": "^4.2.1",
    "web-vitals": "^3.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "commitmsg": "commitlint -E HUSKY_GIT_PARAMS",
    "preview": "vite preview",
    "format": "prettier src -w --log-level warn",
    "lint": "eslint src/ --cache --report-unused-disable-directives --no-ignore"
  },
  "eslintConfig": {
    "extends": [
      "@ivaoaero/eslint-config",
      "@ivaoaero/eslint-config/tailwind",
      "@ivaoaero/eslint-config/react",
      "@ivaoaero/eslint-config/storybook"
    ],
    "parserOptions": {
      "tsconfigRootDir": "./",
      "project": [
        "./tsconfig.json"
      ],
      "extraFileExtensions": [
        ".json",
        ".lock"
      ]
    },
    "rules": {
      "yarn.lock": "off",
      "@typescript-eslint/no-explicit-any": "off",
      "@typescript-eslint/no-unsafe-call": "off",
      "@typescript-eslint/no-unsafe-member-access": "off",
      "@typescript-eslint/no-unsafe-assignment": "off"
    },
    "ignorePatterns": [
      "yarn.lock",
      "*.json"
    ],
    "overrides": [
      {
        "files": [
          "yarn.lock",
          "./.eslintcache",
          "./.lintstagedrc",
          "./package.json",
          "**/*.{js,cjs}"
        ],
        "extends": [
          "plugin:@typescript-eslint/disable-type-checked"
        ]
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.1.1",
    "@ivaoaero/eslint-config": "^1.1.0",
    "@ivaoaero/prettier-config": "^2.1.0",
    "@ivaoby/common": "0.0.3-b",
    "@types/jsonwebtoken": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^0.6.15",
    "eslint-plugin-tailwindcss": "^3.14.1",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.0"
  }
}
