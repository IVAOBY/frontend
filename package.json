{
  "name": "by-frontend",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@headlessui/react": "^2.1.1",
    "@mantine/core": "^6.0.21",
    "@mantine/form": "^6.0.18",
    "@mantine/hooks": "^6.0.21",
    "@mantine/notifications": "^6.0.18",
    "@tabler/icons-react": "^2.42.0",
    "@tanstack/query-sync-storage-persister": "^5.62.9",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-query-devtools": "^5.62.10",
    "@tanstack/react-query-persist-client": "^5.62.11",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.10",
    "@types/mapbox-gl": "^2.7.19",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "axios": "1.8.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "dompurify": "^3.4.17",
    "i18next": "^23.7.7",
    "i18next-browser-languagedetector": "^7.2.0",
    "jwt-decode": "^3.1.2",
    "mapbox-gl": "^2.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "react-map-gl": "^7.1.6",
    "react-router-dom": "^6.20.0",
    "react-snowfall": "^2.2.0",
    "react-spinners": "^0.13.8",
    "tailwind-merge": "^2.2.0",
    "typescript": "^5.3.2",
    "vite-tsconfig-paths": "^4.2.1",
    "web-vitals": "^3.5.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "commitmsg": "commitlint -E HUSKY_GIT_PARAMS",
    "preview": "vite preview",
    "format": "prettier src -w --log-level warn",
    "lint": "eslint src/ --cache --report-unused-disable-directives --no-ignore"
  },
  "eslintConfig": {
    "extends": [
      "@ivao/eslint-config",
      "@ivao/eslint-config/tailwind",
      "@ivao/eslint-config/react",
      "@ivao/eslint-config/storybook"
    ],
    "parserOptions": {
      "tsconfigRootDir": "./",
      "project": [
        "./tsconfig.json"
      ],
      "extraFileExtensions": [
        ".json",
        ".lock"
      ]
    },
    "rules": {
      "yarn.lock": "off",
      "@typescript-eslint/no-explicit-any": "off",
      "@typescript-eslint/no-unsafe-call": "off",
      "@typescript-eslint/no-unsafe-member-access": "off",
      "@typescript-eslint/no-unsafe-assignment": "off"
    },
    "ignorePatterns": [
      "yarn.lock",
      "*.json"
    ],
    "overrides": [
      {
        "files": [
          "yarn.lock",
          "./.eslintcache",
          "./.lintstagedrc",
          "./package.json",
          "**/*.{js,cjs}"
        ],
        "extends": [
          "plugin:@typescript-eslint/disable-type-checked"
        ]
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.1.1",
    "@ivao/eslint-config": "^1.1.0",
    "@ivao/prettier-config": "^1.1.0",
    "@testing-library/dom": "^10.4.0",
    "@types/dompurify": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^0.6.15",
    "eslint-plugin-tailwindcss": "^3.14.1",
    "postcss": "^8.1.0",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwind-corner-smoothing": "^1.2.0",
    "tailwindcss": "^3.4.0",
    "vite": "5.4.21"
  },
  "packageManager": "yarn@4.14.1"
}
